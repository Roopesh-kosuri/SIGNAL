# ============================================================
# SIGNAL Backend — Environment Variables
# ============================================================

# --- BACKEND-ONLY: Used EXCLUSIVELY for the News Feed AI analysis ---
# This key NEVER goes to the frontend, NEVER used for Chat/Fact-Checker/Quiz/Foundations
BACKEND_NEWS_GEMINI_KEY=your_gemini_api_key_here

# --- NewsAPI.org key — for fetching real news headlines ---
# Free tier at https://newsapi.org/register (100 req/day, 3hr cache = ~8 req/day)
# Feed uses: NewsAPI for real articles → Gemini to structure/analyze them
NEWSAPI_KEY=your_newsapi_key_here

# --- CORS: Frontend URL ---
FRONTEND_URL=http://localhost:5173

# --- Optional: Deployment ---
# PORT=8000

