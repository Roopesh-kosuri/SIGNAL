# ============================================================
# SIGNAL Frontend — Environment Variables
# ============================================================
# Copy this file to .env and fill in your values.
# VITE_ prefix is required for Vite to expose vars to the browser.
# ============================================================

# ── Firebase Config ─────────────────────────────────────────
# Get these from: Firebase Console > Project Settings > Your apps
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# ── Backend API URL ──────────────────────────────────────────
# For local dev: the Vite proxy handles this automatically (see vite.config.js)
# For production on Vercel, set this to your Render backend URL:
# VITE_API_BASE_URL=https://signal-backend.onrender.com

# ── NOTE: User AI keys are NOT stored here ──────────────────
# Gemini, Groq, Claude, and OpenAI user keys are entered in
# the Settings page and stored in localStorage only.
# They are NEVER in .env files or sent to the backend.
